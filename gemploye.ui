      <property name="styleSheet">
       <string notr="true">/* Style for the QTabWidget (the container) */
QTabWidget::pane {
    /* Removes the border around the content area */
    border: 1px solid #c4c4c4;
}

/* Style for the QTabBar (the tab buttons themselves) */
QTabBar {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

/* Style for the selected tab */
QTabBar::tab:selected {
    background-color: white; /* White background for the active tab */
    color: black; /* Black text for the active tab */
    border: 1px solid #c4c4c4; /* A light border */
    border-bottom: none; /* No border at the bottom to blend with the content pane */
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 15px; /* Add some padding for spacing */
}

/* Style for the unselected tabs */
QTabBar::tab:!selected {
    background-color: transparent; /* Transparent background for inactive tabs */
    color: white; /* White text for inactive tabs */
    border: 1px solid transparent; /* Transparent border */
    padding: 8px 15px; /* Add some padding for spacing */
}

/* Style for the unselected tabs on hover */
QTabBar::tab:!selected:hover {
    background-color: rgba(255, 255, 255, 0.1); /* A subtle white transparency on hover */
}
</string>
